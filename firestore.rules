rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function pub() {
      return resource.data.published == true;
    }

    match /projects/{id} {
      allow read: if pub() || signedIn();
      allow write: if signedIn();
    }
    match /resaleProperties/{id} {
      allow read: if pub() || signedIn();
      allow write: if signedIn();
    }
    match /rentalProperties/{id} {
      allow read: if pub() || signedIn();
      allow write: if signedIn();
    }
    match /blogs/{id} {
      allow read: if pub() || signedIn();
      allow write: if signedIn();
    }
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'source', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.source is string;
      allow read, update, delete: if signedIn();
    }
    // Page hero banners — public read (site), admin write
    match /banners/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
